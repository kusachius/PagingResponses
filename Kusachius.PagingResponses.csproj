<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ReleaseVersion>1.4</ReleaseVersion>
    <PackageId>Kusachius.PagingResponses</PackageId>
    <PackageVersion>$(ReleaseVersion).0</PackageVersion>
    <Authors>Aldis Arust</Authors>
    <Description>Paging, sorting, and filtering helpers for ASP.NET Core and Entity Framework Core APIs, with a paged JSON response envelope.</Description>
    <PackageTags>ASP.NET Core;Entity Framework Core;paging;pagination;sorting;filtering</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kusachius/PagingResponses</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="10.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Features" Version="5.0.17" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.2.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Kusachius.PagingResponses.Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
